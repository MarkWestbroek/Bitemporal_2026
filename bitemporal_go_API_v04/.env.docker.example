# Copy this file to .env.docker and replace values.
# Do not commit .env.docker with real secrets.

# Image tags
POSTGRES_IMAGE=postgres:16-alpine
API_IMAGE=markwestbroek/bitemp-go-api:v04.00.01

# Database container + API connection settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=bitemp_go_db
DB_HOST=bitemp-postgres
DB_PORT=5432
DB_SSLMODE=disable

# API runtime settings
APP_ENV=production
GIN_MODE=release
ALLOW_DROP_TABLES=false
ADMIN_DROP_PASSWORD=change-this-admin-password
