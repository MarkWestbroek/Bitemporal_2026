{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Vite: Start + Open in Browser",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://127.0.0.1:5173",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Vite: Start Dev Server",
      "postDebugTask": "Vite: Stop Dev Server"
    },
    {
      "name": "Vite Preview: Open in Browser",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://127.0.0.1:4173",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Vite: Preview",
      "postDebugTask": "Vite: Stop Preview"
    },
    {
      "name": "Vite: Rebuild",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm.cmd run build",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Vite: Restart Dev Server",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm.cmd run dev -- --host 127.0.0.1 --port 5173 --strictPort",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Vite: Stop Dev Server"
    }
  ]
}
