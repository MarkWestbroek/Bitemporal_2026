# Office-lockbestanden (ontstaan zolang een document open staat)
**/~$*

# Vite dependency-cache (dev-server artefact)
.vite/

# Lokale omgevingsvariabelen — nooit committen (bevatten wachtwoorden/keys).
# Alleen de *.example-sjablonen gaan mee de repo in.
.env
.env.*
!.env.example
!.env.*.example

# Python-bytecode: wordt door Python zelf (opnieuw) aangemaakt, per versie en machine.
__pycache__/
*.pyc

# VS Code-workspace-instellingen: persoonlijk en per machine (zoom, Copilot-goedkeuringen,
# lokale databaseverbinding). launch.json en tasks.json blijven wel getrackt.
.vscode/settings.json
