# ------------------------------------------------------------
# Bitemporal Go API - environment example
# Copy this file to .env and adjust values for your environment.
# ------------------------------------------------------------

# App mode
APP_ENV=development
GIN_MODE=debug

# Logging flags
# Bun SQL query logging (true/1 enables verbose SQL output)
BUNDEBUG=0
# Custom debug prints in handlers/model (true/1 enables extra fmt logging)
APP_DEBUG_LOGS=1

# Database connection (used by main.go)
DATABASE_URL=postgres://postgres:1234@localhost:5432/bitemp_go_db_v06?sslmode=disable

# Admin drop-table endpoint safety controls
# Endpoint: DELETE /admin/db/droptables/:password
ALLOW_DROP_TABLES=false
ADMIN_DROP_PASSWORD=change-this-password
# Optional first-deploy DB bootstrap (disabled by default)
# AUTO_CREATE_DATABASE="true"
# DATABASE_ADMIN_URL="postgres://postgres:<password>@<host>:5432/postgres?sslmode=disable"

# Metadata for the explicit code-model endpoint: GET /api/schema/model/code
# These values are returned when exporting the current code-state directly,
# independent of any active schema version stored in the database.
# SCHEMA_CODE_MODEL_NAAM="Bitemp register v06"
# SCHEMA_CODE_MODEL_BESCHRIJVING="Actuele modeldefinitie uit de draaiende code"
# SCHEMA_CODE_MODEL_VERSIE="v06.2026-03-22"
# SCHEMA_CODE_BUILD_VERSIE="local-dev"
# SCHEMA_CODE_GO_MODULE="github.com/MarkWestbroek/Bitemporal_2026/bitemp_register_v06"
# SCHEMA_CODE_INDIENER="runtime"
# SCHEMA_CODE_OPMERKING="Code-export voor editor en codegen"

# -----------------------------
# Suggested production values
# -----------------------------
# APP_ENV=production
# GIN_MODE=release
# BUNDEBUG=0
# APP_DEBUG_LOGS=0
# DATABASE_URL=postgres://<user>:<strong-password>@<host>:5432/<db>?sslmode=require
# ALLOW_DROP_TABLES=false
# ADMIN_DROP_PASSWORD=use-a-long-random-secret
# PORT=8081

# -----------------------------
# Authenticatie & Autorisatie
# -----------------------------
# AUTH_ENABLED=false activates the authentication/authorization system.
# When false (default), all endpoints are publicly accessible.
AUTH_ENABLED=false

# JWT signing secret. CHANGE THIS in production!
JWT_SECRET=bitemp-dev-secret-change-in-production

# JWT token expiry in hours (default: 24)
JWT_EXPIRY_HOURS=24

# Seed admin user on startup (only when AUTH_ENABLED=true)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
# ADMIN_EMAIL=admin@example.com

# OpenFTV PDP endpoint (voor PEP middleware)
# OPENFTV_PDP_URL=http://localhost:9004

# PDP-autorisatie inschakelen (vereist AUTH_ENABLED=true)
# Wanneer true, stuurt de PEP middleware evaluatieverzoeken naar de OpenFTV PDP.
# Wanneer false (default), worden alleen lokale rolchecks gebruikt.
AUTHZ_PDP_ENABLED=false

# Gedrag bij PDP-fouten (default: false = fail-open, true = fail-closed)
# AUTHZ_DENY_ON_ERROR=false
