# Dockerfile.frontend — zelfstandige frontend-image voor de Vite-build.
#
# Deze image bouwt de React/Vite-frontend en serveert die via nginx.
# Alle niet-/viz/react routes worden doorgeproxied naar de API-container,
# zodat de frontend dezelfde origin kan gebruiken voor /api, /full, /registratie, enz.

FROM node:22-alpine AS frontend-builder

WORKDIR /app/web/vite

COPY web/vite/package.json web/vite/package-lock.json ./
RUN npm ci

COPY web/vite/ ./

ARG VITE_API_BASE_URL=
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

RUN npm run build

FROM nginx:1.27-alpine

# Instelbaar per instantie, zonder nieuwe build (zie deploy/frontend/default.conf.template):
#   API_UPSTREAM     backend achter deze frontend          (schema://host[:poort], zonder pad)
#   NGINX_RESOLVER   DNS voor het per verzoek opzoeken     (127.0.0.11 = Docker; elders bv. de cluster-DNS)
#   FRAME_ANCESTORS  wie de Studio in een iframe mag tonen ("*" = iedereen)
# De defaults geven exact het gedrag van vóór deze instellingen.
ENV API_UPSTREAM=http://api:8080 \
    NGINX_RESOLVER=127.0.0.11 \
    FRAME_ANCESTORS=*

# De nginx-image zet templates bij het starten om naar /etc/nginx/conf.d/ (envsubst) en
# sourced *.envsh in /docker-entrypoint.d/ vóór die stap. De meegeleverde default.conf moet weg,
# anders luisteren er twee server-blokken op poort 80.
RUN rm -f /etc/nginx/conf.d/default.conf
COPY deploy/frontend/default.conf.template /etc/nginx/templates/default.conf.template
COPY deploy/frontend/15-api-upstream.envsh /docker-entrypoint.d/15-api-upstream.envsh
RUN chmod +x /docker-entrypoint.d/15-api-upstream.envsh

COPY --from=frontend-builder /app/web/react /usr/share/nginx/html/viz/react

EXPOSE 80
