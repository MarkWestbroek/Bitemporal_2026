{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Go API v06: debug",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Codegen v06: from code endpoint",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/codegen",
            "cwd": "${workspaceFolder}",
            "args": [
                "--from-url",
                "http://localhost:8082/api/schema/model/code",
                "--output",
                "model"
            ]
        },
        {
            "name": "Codegen v06: from file",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/codegen",
            "cwd": "${workspaceFolder}",
            "args": [
                "--input",
                "${input:codegenV3InputPathV06Project}",
                "--output",
                "model"
            ]
        },
        {
            "name": "Codegen v06: from DB model id",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/codegen",
            "cwd": "${workspaceFolder}",
            "args": [
                "--from-url",
                "${input:codegenV3ApiBaseUrlV06Project}/api/schema/model/${input:codegenV3ModelIdV06Project}",
                "--output",
                "model"
            ]
        },
        {
            "name": "Stop API server (v06, :8082)",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "command": "powershell -NoProfile -Command \"$pids = Get-NetTCPConnection -LocalPort 8082 -State Listen -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique; if ($pids) { $pids | ForEach-Object { Stop-Process -Id $_ -Force -ErrorAction SilentlyContinue }; Write-Output ('Stopped API process(es) on :8082: ' + ($pids -join ', ')) } else { Write-Output 'No listening API process found on :8082.' }\""
        },
        {
            "name": "Frontend v06: Vite build",
            "type": "node-terminal",
            "request": "launch",
            "command": "& \"C:\\Program Files\\nodejs\\npm.cmd\" run build",
            "cwd": "${workspaceFolder}/web/vite"
        },
        {
            "name": "Stop Vite server (v06, :5173/:5174/:5175)",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "command": "powershell -NoProfile -Command \"$ports = 5173,5174,5175; $pids = @(); foreach ($port in $ports) { $listening = Get-NetTCPConnection -LocalPort $port -State Listen -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique; if ($listening) { $pids += $listening } }; $pids = $pids | Select-Object -Unique; if ($pids) { $pids | ForEach-Object { Stop-Process -Id $_ -Force -ErrorAction SilentlyContinue }; Write-Output ('Stopped Vite process(es): ' + ($pids -join ', ')) } else { Write-Output 'No listening Vite process found on :5173/:5174/:5175.' }\""
        }
    ],
    "inputs": [
        {
            "id": "codegenV3InputPathV06Project",
            "type": "promptString",
            "description": "Pad naar V3 JSON inputbestand voor codegen (v06)",
            "default": "${workspaceFolder}/metamodel_v3.json"
        },
        {
            "id": "codegenV3ApiBaseUrlV06Project",
            "type": "promptString",
            "description": "Basis-URL van API (zonder trailing slash)",
            "default": "http://localhost:8082"
        },
        {
            "id": "codegenV3ModelIdV06Project",
            "type": "promptString",
            "description": "Schema model ID uit database",
            "default": "1"
        }
    ]
}