        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const ct = pm.response.headers.get('Content-Type') || '';",
                  "if (ct.startsWith('image/svg+xml')) {",
                  "  pm.visualizer.set('<div style=\"background:#f3f4f6;padding:12px\">' + pm.response.text() + '</div>');",
                  "} else {",
                  "  pm.visualizer.set('<pre style=\"white-space:pre-wrap\">{{t}}</pre>', { t: JSON.stringify(pm.response.json(), null, 2) });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "description": "Draait de sidecar?",
            "header": [],
            "url": "{{svcUrl}}/health"
          }
