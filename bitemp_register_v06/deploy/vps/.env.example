# .env voor docker-compose.vps.yml — kopieer naar .env en vul ALLE secrets in.
# Genereer sterke waarden met:  openssl rand -base64 30
# Vermijd het $-teken in wachtwoorden (compose leest het als variabele; zie
# docs/TRUENAS_DEPLOYMENT.md §2.7). Commit dit bestand met echte waarden NOOIT.

# Images — versie-tag = betrouwbare rollback, latest = nieuwste (docs/DOCKER_RELEASE.md)
POSTGRES_IMAGE=postgres:16-alpine
MINIO_IMAGE=minio/minio:latest
API_IMAGE=markwestbroek/bitemp-go-api:latest
FRONTEND_IMAGE=markwestbroek/bitemp-viz-frontend:latest

# Database
POSTGRES_USER=bitemp
POSTGRES_PASSWORD=vul-in
POSTGRES_DB=bitemp_go_db_v06
PG_PORT=5433

# MinIO (bestandsopslag voor Studio-bestanden en modellen)
MINIO_ACCESS_KEY=bitemp
MINIO_SECRET_KEY=vul-in
MINIO_BUCKET=ide-bestanden
MINIO_CONSOLE_PORT=9001

# API
ADMIN_DROP_PASSWORD=vul-in
JWT_SECRET=vul-in
JWT_EXPIRY_HOURS=24
ADMIN_USERNAME=mark
ADMIN_PASSWORD=vul-in
# Na de eerste start mag ADMIN_PASSWORD hier weg: de seed maakt de gebruiker
# alleen aan als die nog niet bestaat.

# Frontend (loopback-poort waar Caddy naartoe proxiet)
FRONTEND_PORT=8083

# OpenFTV (alleen met --profile authz)
AUTHZ_PDP_ENABLED=false
OPENFTV_DB_PASSWORD=vul-in
