# .env voor docker-compose.pf.yml (pf.common-ground-lab.nl) — op de VPS als
# /srv/omnium-pf/.env (chmod 600). Commit dit bestand met echte waarden NOOIT.
# Genereer elk geheim apart op de VPS:  openssl rand -hex 24
# (hex: geen $-tekens, die compose als variabele leest.)

# Database (eigen Postgres, los van Omnium)
POSTGRES_USER=pf
POSTGRES_PASSWORD=
POSTGRES_DB=pf_register
PG_PORT=5435

# MinIO (eigen container, besluit Mark)
# MinIO eist een gebruikersnaam van minstens 3 tekens.
MINIO_ACCESS_KEY=pf-minio
MINIO_SECRET_KEY=
MINIO_BUCKET=ide-bestanden
MINIO_CONSOLE_PORT=9002

# API — na de backend-merge zijn JWT_SECRET en sterke wachtwoorden verplicht.
ADMIN_DROP_PASSWORD=
JWT_SECRET=
JWT_EXPIRY_HOURS=24
ADMIN_USERNAME=mark
ADMIN_PASSWORD=
# Live register: echte kloktijden (de API-default "synthetisch" is voor demo's).
REGISTRATIE_TIJD=klok

# Frontend
FRONTEND_PORT=8084
FRAME_ANCESTORS=*
