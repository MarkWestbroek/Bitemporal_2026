# /etc/caddy/Caddyfile — Caddy als reverse proxy met automatisch Let's Encrypt.
#
# Caddy luistert op 80 en 443, vraagt zelf het certificaat aan zodra het
# A-record naar deze machine wijst, vernieuwt het automatisch en stuurt http
# door naar https. Herladen na wijziging:  sudo systemctl reload caddy

omnium.common-ground-lab.nl {
	encode zstd gzip

	# Zelfde bovengrens als client_max_body_size in nginx.frontend.conf.
	request_body {
		max_size 20MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# De frontend-container (nginx) serveert /viz/react/ en proxiet de rest
	# (/api, /full, /registratie, /docs, /version, ...) naar de Go-API.
	reverse_proxy 127.0.0.1:8083
}

# Later, als musicbrain en de andere sites ook op deze VPS komen: per site
# één blok erbij, meer is het niet.
#
# musicbrain.nl {
# 	reverse_proxy 127.0.0.1:3000
# }
