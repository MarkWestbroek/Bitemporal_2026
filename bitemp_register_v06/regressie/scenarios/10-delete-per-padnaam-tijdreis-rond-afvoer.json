    "afvoer",
    "tijdreizen"
  ],
  "stappen": [
    {
      "naam": "afvoeren",
      "method": "DELETE",
      "path": "/natuurlijk_personen/6",
      "verwacht": {
        "status": 200,
        "json": {
          "registratie_id": ">0"
        }
      },
      "bewaar": {
