      }
    },
    {
      "naam": "weg op afvoertijdstip",
      "method": "GET",
      "path": "/full/natuurlijk_personen/6?t={{regDel}}",
      "verwacht": {
        "status": 404
      }
    },
    {
      "naam": "bestond er nog net voor",
      "method": "GET",
      "path": "/full/natuurlijk_personen/6?t={{min1:regDel}}",
      "verwacht": {
        "status": 200
      }
    },
    {
      "naam": "tweede afvoer geeft conflict",
      "method": "DELETE",
      "path": "/natuurlijk_personen/6",
      "verwacht": {
        "status": 409
      }
    }
