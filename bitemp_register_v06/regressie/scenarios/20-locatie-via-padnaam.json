{
  "id": "20",
  "naam": "locatie via padnaam",
  "tags": [
    "engine"
  ],
  "volgorde": 200,
  "stappen": [
    {
      "method": "POST",
      "path": "/locaties",
      "body": {
        "id": 42
      },
      "verwacht": {
        "status": 201,
        "json": {
          "registratie_id": ">0",
          "tijdstip": "!=null"
        }
      },
      "bewaar": {
        "regId": "registratie_id"
      }
    },
    {
      "method": "GET",
      "path": "/registraties/{{regId}}",
      "verwacht": {
        "status": 200,
        "json": {
          "registratietype": "registratie",
          "id": "{{regId}}"
        }
      }
    },
    {
      "method": "GET",
      "path": "/locaties/42",
      "verwacht": {
        "status": 200,
        "json": {
          "id": 42,
          "opvoer": "!=null",
          "afvoer": "null"
        }
      }
    },
    {
      "naam": "bestond nog niet ten tijde van de seed",
      "method": "GET",
      "path": "/full/locaties/42?t={{seedLaatsteRegistratieID}}",
      "verwacht": {
        "status": 404,
        "bevat": "not found"
      }
    }
  ]
}
