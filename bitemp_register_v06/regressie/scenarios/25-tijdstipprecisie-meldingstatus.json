      "method": "POST",
      "path": "/registratie/",
      "body": {
        "registratie": {
          "registratietype": "registratie",
          "opmerking": "sc25 stap 1"
        },
        "wijzigingen": [
          {
            "opvoer": {
              "melding": {
                "id": 9201
              }
            }
          },
          {
            "opvoer": {
              "meldingstatus": {
                "melding_id": 9201,
                "status": "nieuw",
                "aanvang": "2026-10-27T09:00:00Z"
              }
            }
          }
        ]
      },
      "verwacht": {
        "status": 201
      }
    },
