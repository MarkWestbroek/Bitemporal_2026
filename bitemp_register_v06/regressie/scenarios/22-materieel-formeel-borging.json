      "naam": "1 opvoer NP 9101 met burgerschap NL vanaf 2000-01-01",
      "method": "POST",
      "path": "/registratie/",
      "body": {"registratie": {"registratietype": "registratie", "opmerking": "sc22 stap 1"}, "wijzigingen": [
        {"opvoer": {"natuurlijkpersoon": {"id": 9101}}},
        {"opvoer": {"burgerschap": {"natuurlijkpersoon_id": 9101, "landcode": "NL", "nationaliteit": "Nederlandse", "aanvang": "2000-01-01"}}}
      ]},
      "verwacht": {"status": 201},
      "bewaar": {"reg1": "registratie_id"}
    },
    {
      "naam": "na 1: één voorkomen, data v1, aanvang 2000-01-01",
