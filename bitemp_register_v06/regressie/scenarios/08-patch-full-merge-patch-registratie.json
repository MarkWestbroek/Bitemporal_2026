      }
    },
    {
      "naam": "nieuwe naam actief",
      "method": "GET",
      "path": "/full/natuurlijk_personen/2",
      "verwacht": {
        "status": 200,
        "json": {
          "namen[afvoer=null].data[afvoer=null].achternaam": "Gewijzigd"
        }
      }
    }
  ]
