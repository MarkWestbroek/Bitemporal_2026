{
  "uitleg": "Use case-realisaties van samenwerken: operatie van A naar B (sequence), snapshot en compactie (sequence), herverbinden (activity), werkruimte (sequence).",
  "diagrammen": [
    { "sleutel": "seqSync", "taal": "sequence05", "naam": "Operatie van A naar B (outbox → ops → SSE)", "map": "Werk live samen aan een project" },
    { "sleutel": "seqSnap", "taal": "sequence05", "naam": "Snapshot en compactie", "map": "Werk live samen aan een project" },
    { "sleutel": "actHerverbind", "taal": "activity05", "naam": "Herverbinden: naspelen of snapshot opnieuw", "map": "Werk live samen aan een project" },
    { "sleutel": "seqStuur", "taal": "sequence05", "naam": "Naar server sturen en van server ophalen", "map": "Stuur het project naar de server of haal het op" },
    { "sleutel": "seqWerkruimte", "taal": "sequence05", "naam": "Werkruimte per gebruiker (laatste schrijver wint)", "map": "Ga op een ander apparaat verder (werkruimte)" }
  ],
  "elementen": [
    { "sleutel": "sA", "type": "levenslijn", "naam": "Studio A (store, outbox, verzender)", "diagram": "seqSync" },
    { "sleutel": "sApi", "type": "levenslijn", "naam": "Go-API", "diagram": "seqSync" },
    { "sleutel": "sOps", "type": "levenslijn", "naam": "studio_project_ops", "diagram": "seqSync" },
    { "sleutel": "sHub", "type": "levenslijn", "naam": "SSE-hub", "diagram": "seqSync" },
    { "sleutel": "sB", "type": "levenslijn", "naam": "Studio B", "diagram": "seqSync" },

    { "sleutel": "pClient", "type": "levenslijn", "naam": "Online client (bij, outbox leeg)", "diagram": "seqSnap" },
    { "sleutel": "pApi", "type": "levenslijn", "naam": "Go-API", "diagram": "seqSnap" },
    { "sleutel": "pProj", "type": "levenslijn", "naam": "studio_projecten", "diagram": "seqSnap" },
    { "sleutel": "pOps", "type": "levenslijn", "naam": "studio_project_ops", "diagram": "seqSnap" },
    { "sleutel": "pLaat", "type": "levenslijn", "naam": "Late client (vóór de grens)", "diagram": "seqSnap" },

    { "sleutel": "h0", "type": "begin", "naam": "", "diagram": "actHerverbind" },
    { "sleutel": "h1", "type": "actie", "naam": "Verbinding valt weg; EventSource herverbindt met Last-Event-ID", "diagram": "actHerverbind" },
    { "sleutel": "hb1", "type": "beslissing", "naam": "Volgnummer vóór de compactiegrens?", "diagram": "actHerverbind" },
    { "sleutel": "h2", "type": "actie", "naam": "event: snapshot → snapshot opnieuw laden (werkruimte blijft)", "diagram": "actHerverbind" },
    { "sleutel": "h3", "type": "actie", "naam": "Server speelt operaties ná het volgnummer na; event: stand", "diagram": "actHerverbind" },
    { "sleutel": "h4", "type": "actie", "naam": "Operaties idempotent toepassen (eigen client-id overslaan, undo-rebase)", "diagram": "actHerverbind" },
    { "sleutel": "h5", "type": "actie", "naam": "Outbox leegsturen", "diagram": "actHerverbind" },
    { "sleutel": "hb2", "type": "beslissing", "naam": "Antwoord?", "diagram": "actHerverbind" },
    { "sleutel": "h6", "type": "actie", "naam": "Netwerkfout: opnieuw met backoff 1–30 s (poll als terugval)", "diagram": "actHerverbind" },
    { "sleutel": "h7", "type": "actie", "naam": "404: project niet op de server; 400: batch overslaan", "diagram": "actHerverbind" },
    { "sleutel": "hb3", "type": "beslissing", "naam": "Log ≥ 200 voorbij de grens en bij?", "diagram": "actHerverbind" },
    { "sleutel": "h8", "type": "actie", "naam": "Stille snapshot (PUT met tot_volgnummer)", "diagram": "actHerverbind" },
    { "sleutel": "h9", "type": "eind", "naam": "", "diagram": "actHerverbind" },

    { "sleutel": "tUser", "type": "levenslijn", "naam": "Modelleur", "diagram": "seqStuur" },
    { "sleutel": "tStudio", "type": "levenslijn", "naam": "Studio (menu Project)", "diagram": "seqStuur" },
    { "sleutel": "tApi", "type": "levenslijn", "naam": "Go-API", "diagram": "seqStuur" },
    { "sleutel": "tProj", "type": "levenslijn", "naam": "studio_projecten (blob, versie, grens)", "diagram": "seqStuur" },

    { "sleutel": "wDesk", "type": "levenslijn", "naam": "Studio op de desktop", "diagram": "seqWerkruimte" },
    { "sleutel": "wApi", "type": "levenslijn", "naam": "Go-API", "diagram": "seqWerkruimte" },
    { "sleutel": "wTab", "type": "levenslijn", "naam": "studio_werkruimtes (project + gebruiker)", "diagram": "seqWerkruimte" },
    { "sleutel": "wLap", "type": "levenslijn", "naam": "Studio op de laptop", "diagram": "seqWerkruimte" }
  ],
  "connectoren": [
    { "type": "synchroon", "bron": "sA", "doel": "sA", "naam": "store-actie lokaal; operatie {store, op, args} in de outbox" },
    { "type": "synchroon", "bron": "sA", "doel": "sApi", "naam": "POST …/ops {clientId, ops[]} (na 300 ms debounce, batch ≤ 200)" },
    { "type": "synchroon", "bron": "sApi", "doel": "sOps", "naam": "BEGIN; projectrij FOR UPDATE; volgnummers toekennen; INSERT; COMMIT" },
    { "type": "retour", "bron": "sApi", "doel": "sA", "naam": "201 {van, tot, laatsteLokaalNr} → outbox bevestigd" },
    { "type": "asynchroon", "bron": "sApi", "doel": "sHub", "naam": "NaStudioProjectOps(ops)" },
    { "type": "asynchroon", "bron": "sHub", "doel": "sB", "naam": "event: op (id = volgnummer, data = operatie)" },
    { "type": "asynchroon", "bron": "sHub", "doel": "sA", "naam": "event: op (eigen client-id → overslaan, volgnummer opschuiven)" },
    { "type": "synchroon", "bron": "sB", "doel": "sB", "naam": "pasOperatieToe: zelfde actie, undo gepauzeerd en gerebased" },

    { "type": "synchroon", "bron": "pClient", "doel": "pApi", "naam": "PUT /api/studio/projecten/:id {inhoud, versie, tot_volgnummer}" },
    { "type": "synchroon", "bron": "pApi", "doel": "pProj", "naam": "versie = huidig? anders 409 met servermeta" },
    { "type": "synchroon", "bron": "pApi", "doel": "pProj", "naam": "UPDATE inhoud, versie+1, tot_volgnummer (nooit terug, afgekapt op het log)" },
    { "type": "synchroon", "bron": "pApi", "doel": "pOps", "naam": "DELETE operaties ≤ grens" },
    { "type": "retour", "bron": "pApi", "doel": "pClient", "naam": "200 meta (of 409: grens van de ander overnemen)" },
    { "type": "synchroon", "bron": "pLaat", "doel": "pApi", "naam": "GET …/ops?vanaf=N  (N < grens)" },
    { "type": "retour", "bron": "pApi", "doel": "pLaat", "naam": "{snapshotNodig: true, totVolgnummer}" },
    { "type": "synchroon", "bron": "pLaat", "doel": "pApi", "naam": "GET …/projecten/:id (snapshot) + GET …/ops?vanaf=grens" },

    { "type": "controlestroom", "bron": "h0", "doel": "h1" },
    { "type": "controlestroom", "bron": "h1", "doel": "hb1" },
    { "type": "controlestroom", "bron": "hb1", "doel": "h2", "eigenschappen": { "guard": "ja" } },
    { "type": "controlestroom", "bron": "hb1", "doel": "h3", "eigenschappen": { "guard": "nee" } },
    { "type": "controlestroom", "bron": "h2", "doel": "h3" },
    { "type": "controlestroom", "bron": "h3", "doel": "h4" },
    { "type": "controlestroom", "bron": "h4", "doel": "h5" },
    { "type": "controlestroom", "bron": "h5", "doel": "hb2" },
    { "type": "controlestroom", "bron": "hb2", "doel": "h6", "eigenschappen": { "guard": "netwerkfout" } },
    { "type": "controlestroom", "bron": "h6", "doel": "h5" },
    { "type": "controlestroom", "bron": "hb2", "doel": "h7", "eigenschappen": { "guard": "404 / 400" } },
    { "type": "controlestroom", "bron": "h7", "doel": "h9" },
    { "type": "controlestroom", "bron": "hb2", "doel": "hb3", "eigenschappen": { "guard": "201" } },
    { "type": "controlestroom", "bron": "hb3", "doel": "h8", "eigenschappen": { "guard": "ja" } },
    { "type": "controlestroom", "bron": "h8", "doel": "h9" },
    { "type": "controlestroom", "bron": "hb3", "doel": "h9", "eigenschappen": { "guard": "nee" } },

    { "type": "synchroon", "bron": "tUser", "doel": "tStudio", "naam": "Project → Naar server sturen (snapshot)" },
    { "type": "synchroon", "bron": "tStudio", "doel": "tStudio", "naam": "eerst de outbox leeg (verzend)" },
    { "type": "synchroon", "bron": "tStudio", "doel": "tApi", "naam": "POST (nieuw) of PUT {naam, inhoud v3, versie, tot_volgnummer}" },
    { "type": "synchroon", "bron": "tApi", "doel": "tProj", "naam": "aanmaken of versie controleren en opslaan" },
    { "type": "retour", "bron": "tApi", "doel": "tStudio", "naam": "201/200 meta, of 409 → overschrijven of afbreken" },
    { "type": "synchroon", "bron": "tUser", "doel": "tStudio", "naam": "Project → Van server ophalen… (keuze uit de lijst)" },
    { "type": "synchroon", "bron": "tStudio", "doel": "tApi", "naam": "GET /api/studio/projecten/:id (snapshot)" },
    { "type": "retour", "bron": "tApi", "doel": "tStudio", "naam": "inhoud, versie, tot_volgnummer" },
    { "type": "synchroon", "bron": "tStudio", "doel": "tStudio", "naam": "pasProjectToe (zonder vastleggen); werkruimte van dit project" },
    { "type": "synchroon", "bron": "tStudio", "doel": "tApi", "naam": "GET …/ops?vanaf=tot_volgnummer (ook eigen operaties)" },

    { "type": "synchroon", "bron": "wDesk", "doel": "wApi", "naam": "PUT …/werkruimte {inhoud: tabs, actieveTab, mapOpen; bijgewerkt} (1,5 s na een wijziging)" },
    { "type": "synchroon", "bron": "wApi", "doel": "wTab", "naam": "upsert, alleen als bijgewerkt ≥ huidig" },
    { "type": "synchroon", "bron": "wLap", "doel": "wApi", "naam": "GET …/werkruimte (bij het openen van het project)" },
    { "type": "retour", "bron": "wApi", "doel": "wLap", "naam": "{inhoud, bijgewerkt}" },
    { "type": "synchroon", "bron": "wLap", "doel": "wLap", "naam": "nieuwer dan lokaal? dan overnemen (tabs die bestaan)" }
  ],
  "opstelling": [
    { "diagram": "seqSync", "actie": "automatisch" },
    { "diagram": "seqSnap", "actie": "automatisch" },
    { "diagram": "actHerverbind", "actie": "automatisch" },
    { "diagram": "seqStuur", "actie": "automatisch" },
    { "diagram": "seqWerkruimte", "actie": "automatisch" }
  ]
}
