{
  "uitleg": "Use case-realisaties: transformatie (sequence + roundtrip-activity), Sparx EA-import via de sidecar (activity), render-API vanuit Imprint (sequence).",
  "diagrammen": [
    { "sleutel": "seqTrans", "taal": "sequence05", "naam": "Transformatie: lezer → regelset → toepasser → schrijver", "map": "Importeer een model (ArchiMate, OAS, Mermaid, BPMN, DMN)" },
    { "sleutel": "actRound", "taal": "activity05", "naam": "Transformatie-roundtrip (Mermaid ↔ use case)", "map": "Importeer een model (ArchiMate, OAS, Mermaid, BPMN, DMN)" },
    { "sleutel": "actEA", "taal": "activity05", "naam": "EA-import via de sidecar (importeer-qea)", "map": "Importeer een Sparx EA-pakket (.qea)" },
    { "sleutel": "seqRender", "taal": "sequence05", "naam": "Render-API vanuit Imprint", "map": "Vraag een modeldiagram op als SVG" }
  ],
  "elementen": [
    { "sleutel": "xUser", "type": "levenslijn", "naam": "Modelleur", "diagram": "seqTrans" },
    { "sleutel": "xPaneel", "type": "levenslijn", "naam": "TransformatiePaneel", "diagram": "seqTrans" },
    { "sleutel": "xReg", "type": "levenslijn", "naam": "transformatieRegistry", "diagram": "seqTrans" },
    { "sleutel": "xLezer", "type": "levenslijn", "naam": "Lezer (parser)", "diagram": "seqTrans" },
    { "sleutel": "xToep", "type": "levenslijn", "naam": "Toepasser + regelset (data)", "diagram": "seqTrans" },
    { "sleutel": "xStore", "type": "levenslijn", "naam": "createDiagramStore (profiel)", "diagram": "seqTrans" },

    { "sleutel": "q0", "type": "begin", "naam": "", "diagram": "actRound" },
    { "sleutel": "q1", "type": "actie", "naam": "Bron lezen; lezer maakt de brongraaf", "diagram": "actRound" },
    { "sleutel": "qb1", "type": "beslissing", "naam": "Parseerfout?", "diagram": "actRound" },
    { "sleutel": "q2", "type": "actie", "naam": "Diagnostics melden; stop", "diagram": "actRound" },
    { "sleutel": "q3", "type": "actie", "naam": "Regelset toepassen → plan met trace; onbekende patronen melden, niet stil weglaten", "diagram": "actRound" },
    { "sleutel": "q4", "type": "actie", "naam": "Valideren vóór de mutatie; atomisch importeren (één undo-stap)", "diagram": "actRound" },
    { "sleutel": "q5", "type": "actie", "naam": "Terugweg: modelNaarGraaf → regelset → schrijver → tekst", "diagram": "actRound" },
    { "sleutel": "qb2", "type": "beslissing", "naam": "Uitvoer gelijk aan de bron?", "diagram": "actRound" },
    { "sleutel": "q6", "type": "actie", "naam": "Verschil melden (roundtrip-test)", "diagram": "actRound" },
    { "sleutel": "q7", "type": "eind", "naam": "", "diagram": "actRound" },

    { "sleutel": "e0", "type": "begin", "naam": "", "diagram": "actEA" },
    { "sleutel": "e1", "type": "actie", "naam": "git pull --ff-only op de checkout met het .qea-bestand", "diagram": "actEA" },
    { "sleutel": "e2", "type": "actie", "naam": ".qea lezen (sql.js); pakket kiezen op id of pad", "diagram": "actEA" },
    { "sleutel": "e3", "type": "actie", "naam": "Inloggen (cookie of token); serverproject ophalen en naspelen", "diagram": "actEA" },
    { "sleutel": "e4", "type": "actie", "naam": "Vergelijken op EA-GUID (merge-op-GUID)", "diagram": "actEA" },
    { "sleutel": "eb1", "type": "beslissing", "naam": "Verdwenen elementen verwijderen (vlag)?", "diagram": "actEA" },
    { "sleutel": "e5", "type": "actie", "naam": "Verwijder-operaties opnemen", "diagram": "actEA" },
    { "sleutel": "eb2", "type": "beslissing", "naam": "--droog?", "diagram": "actEA" },
    { "sleutel": "e6", "type": "actie", "naam": "Alleen een verslag", "diagram": "actEA" },
    { "sleutel": "e7", "type": "actie", "naam": "Verschil als patch-operaties in batches (≤ 500, ≤ 7 MB) naar POST …/ops; idempotent", "diagram": "actEA" },
    { "sleutel": "e8", "type": "eind", "naam": "", "diagram": "actEA" },

    { "sleutel": "iImprint", "type": "levenslijn", "naam": "Imprint", "diagram": "seqRender" },
    { "sleutel": "iApi", "type": "levenslijn", "naam": "Go-API", "diagram": "seqRender" },
    { "sleutel": "iSchema", "type": "levenslijn", "naam": "schema_versies", "diagram": "seqRender" },
    { "sleutel": "iSvc", "type": "levenslijn", "naam": "render-svc (diagramsvg)", "diagram": "seqRender" }
  ],
  "connectoren": [
    { "type": "synchroon", "bron": "xUser", "doel": "xPaneel", "naam": "map, richting import, bron (bestand of tekst), opties" },
    { "type": "synchroon", "bron": "xPaneel", "doel": "xReg", "naam": "detecteer of kies transformatie" },
    { "type": "synchroon", "bron": "xReg", "doel": "xLezer", "naam": "lees(bron) → brongraaf" },
    { "type": "synchroon", "bron": "xReg", "doel": "xToep", "naam": "pasToe(brongraaf, regelset) → plan + trace + meldingen" },
    { "type": "synchroon", "bron": "xToep", "doel": "xStore", "naam": "importeerModel(plan) — valideren, atomisch, één undo-stap" },
    { "type": "retour", "bron": "xStore", "doel": "xReg", "naam": "created" },
    { "type": "retour", "bron": "xReg", "doel": "xPaneel", "naam": "{status, summary, diagnostics, created}" },

    { "type": "controlestroom", "bron": "q0", "doel": "q1" },
    { "type": "controlestroom", "bron": "q1", "doel": "qb1" },
    { "type": "controlestroom", "bron": "qb1", "doel": "q2", "eigenschappen": { "guard": "ja" } },
    { "type": "controlestroom", "bron": "q2", "doel": "q7" },
    { "type": "controlestroom", "bron": "qb1", "doel": "q3", "eigenschappen": { "guard": "nee" } },
    { "type": "controlestroom", "bron": "q3", "doel": "q4" },
    { "type": "controlestroom", "bron": "q4", "doel": "q5" },
    { "type": "controlestroom", "bron": "q5", "doel": "qb2" },
    { "type": "controlestroom", "bron": "qb2", "doel": "q6", "eigenschappen": { "guard": "nee" } },
    { "type": "controlestroom", "bron": "q6", "doel": "q7" },
    { "type": "controlestroom", "bron": "qb2", "doel": "q7", "eigenschappen": { "guard": "ja" } },

    { "type": "controlestroom", "bron": "e0", "doel": "e1" },
    { "type": "controlestroom", "bron": "e1", "doel": "e2" },
    { "type": "controlestroom", "bron": "e2", "doel": "e3" },
    { "type": "controlestroom", "bron": "e3", "doel": "e4" },
    { "type": "controlestroom", "bron": "e4", "doel": "eb1" },
    { "type": "controlestroom", "bron": "eb1", "doel": "e5", "eigenschappen": { "guard": "ja" } },
    { "type": "controlestroom", "bron": "e5", "doel": "eb2" },
    { "type": "controlestroom", "bron": "eb1", "doel": "eb2", "eigenschappen": { "guard": "nee (standaard)" } },
    { "type": "controlestroom", "bron": "eb2", "doel": "e6", "eigenschappen": { "guard": "ja" } },
    { "type": "controlestroom", "bron": "e6", "doel": "e8" },
    { "type": "controlestroom", "bron": "eb2", "doel": "e7", "eigenschappen": { "guard": "nee" } },
    { "type": "controlestroom", "bron": "e7", "doel": "e8" },

    { "type": "synchroon", "bron": "iImprint", "doel": "iApi", "naam": "GET /api/models/{naam}/views.json" },
    { "type": "retour", "bron": "iApi", "doel": "iImprint", "naam": "keuzelijst van diagrammen en domeinen" },
    { "type": "synchroon", "bron": "iImprint", "doel": "iApi", "naam": "GET /api/models/{naam}/diagram.svg?versie&asOf&diagram|domein (If-None-Match)" },
    { "type": "synchroon", "bron": "iApi", "doel": "iSchema", "naam": "nieuwste schema-versie met tijdstip ≤ asOf" },
    { "type": "synchroon", "bron": "iApi", "doel": "iSvc", "naam": "POST render (V3-model, keuze)" },
    { "type": "synchroon", "bron": "iSvc", "doel": "iSvc", "naam": "v3ModelNaarEditor → autoLayout → pure SVG" },
    { "type": "retour", "bron": "iSvc", "doel": "iApi", "naam": "SVG (of 502 zonder sidecar)" },
    { "type": "retour", "bron": "iApi", "doel": "iImprint", "naam": "200 SVG met ETag en Last-Modified, of 304" }
  ],
  "opstelling": [
    { "diagram": "seqTrans", "actie": "automatisch" },
    { "diagram": "actRound", "actie": "automatisch" },
    { "diagram": "actEA", "actie": "automatisch" },
    { "diagram": "seqRender", "actie": "automatisch" }
  ]
