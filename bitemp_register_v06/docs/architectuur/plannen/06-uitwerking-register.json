    { "type": "retour", "bron": "zPg", "doel": "zApi", "naam": "rijen op t" },
    { "type": "synchroon", "bron": "zApi", "doel": "zApi", "naam": "genest resultaat samenstellen (hub met _Data, relaties)" },
    { "type": "synchroon", "bron": "zApi", "doel": "zPep", "naam": "snoei(resultaat, subject, resource ENT.GE.veld)" },
    { "type": "synchroon", "bron": "zPep", "doel": "zPdp", "naam": "toegestane paden? (gecachet per subject)" },
    { "type": "retour", "bron": "zPdp", "doel": "zPep", "naam": "paden (Standaard, Bij conflict; fail-closed)" },
    { "type": "retour", "bron": "zPep", "doel": "zApi", "naam": "gesnoeid resultaat of 403" },
    { "type": "retour", "bron": "zApi", "doel": "zLezer", "naam": "200 JSON (stand op t)" },

    { "type": "synchroon", "bron": "cEditor", "doel": "cApi", "naam": "POST /api/schema/model (V3 JSON)" },
