          ]
        },
        {
          "naam": "DetailTemplate",
          "description": "Template voor de detail-pagina met {{veldpad}} inserts. Wordt gerenderd als read-only publicatieweergave.",
          "meervoud": "weergave_definitie_detail_templates",
          "momentvoorkomen": "meervoudig",
          "isMaterieel": false,
          "velden": [
            {
              "naam": "template_tekst",
              "goType": "string",
              "description": "Markdown-achtig template met {{veldpad}} inserts, bijv. '{{Naam.roepnaam}} {{Naam.achternaam}}'."
            },
            {
              "naam": "definitie_versie",
              "goType": "string",
              "datatype": "Versie",
              "description": "Versienummer van het detail-template (semver: m.n.o.p)."
            }
          ]
        }
      ],
      "relaties": []
    }
  ]
}
