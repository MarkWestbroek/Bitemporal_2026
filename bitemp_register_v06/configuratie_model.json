              "goType": "string",
              "description": "Toelichting op doel en gebruik van deze weergave."
            },
            {
              "naam": "doeltype",
              "goType": "string",
              "description": "Typenaam van de doelentiteit waarvoor deze weergave is bedoeld, bijv. 'NatuurlijkPersoon'."
            },
            {
              "naam": "status",
              "goType": "WeergaveDefinitieStatus",
              "enum": "WeergaveDefinitieStatus",
              "description": "Levenscyclusstatus: concept, actief of inactief."
            },
            {
              "naam": "is_standaard",
              "goType": "*bool",
              "description": "True als dit de standaardweergave is voor het doeltype."
            }
          ]
        },
        {
          "naam": "TabelConfig",
          "description": "Configuratie van de tabelweergave: kolomdefinities (veldpad, label, breedte, sorteerbaar, filterbaar), standaardsortering en aantal rijen per pagina.",
          "meervoud": "weergave_definitie_tabel_configs",
          "momentvoorkomen": "meervoudig",
          "isMaterieel": false,
          "velden": [
            {
              "naam": "tabel_config_json",
              "goType": "string",
              "description": "JSON-string met kolomdefinities, standaardsortering en paginering-instellingen."
            },
            {
              "naam": "definitie_versie",
              "goType": "string",
              "datatype": "Versie",
              "description": "Versienummer van de tabelconfiguratie (semver: m.n.o.p)."
