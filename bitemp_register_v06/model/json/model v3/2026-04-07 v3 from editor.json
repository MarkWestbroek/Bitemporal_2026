      "basistype": "string",
      "format": "nl-postcode",
      "positie": {
        "x": 570,
        "y": -330
      },
      "validatie": {
        "pattern": "^[1-9][0-9]{3}\\s?[A-Za-z]{2}$",
        "maxLength": 7,
        "minLength": 6,
        "foutmelding": "Voer een geldige postcode in (bijv. 1234 AB)",
        "voorbeelden": [
          "1234 AB",
          "9999ZZ"
        ]
      },
      "normalisatie": "uppercase_letters",
      "weergave": {
        "inputMask": "0000 AA",
        "placeholder": "1234 AB"
      }
    },
