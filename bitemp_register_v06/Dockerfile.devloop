# Dockerfile.devloop — Self-rebuilding register container
#
# Dit image bevat de Go toolchain, Node.js en de volledige broncode,
# zodat het register zichzelf kan hergenereren en hercompileren vanuit
# de UML-editor of een V3 JSON model.
#
# Gebruik: docker compose -f docker-compose.devloop.yml up --build

# ---------- Stage 1: Frontend build (zelfde als productie) ----------
FROM node:22-alpine AS frontend-builder

WORKDIR /app/web/vite
COPY web/vite/package.json web/vite/package-lock.json ./
RUN npm ci
COPY web/vite/ ./
# De UML-editor module zit nu binnen web/vite/src/umleditor en komt automatisch mee.
RUN npm run build

# ---------- Stage 2: Devloop image met Go + Node + source ----------
FROM golang:1.25-alpine

RUN apk add --no-cache git nodejs npm bash

WORKDIR /app

# Go dependencies (gecached als go.mod/go.sum niet verandert)
COPY go.mod go.sum ./
RUN go mod download

# Volledige broncode
COPY . .

# Gebruik de frontend build uit stage 1
COPY --from=frontend-builder /app/web/react ./web/react

# Initiële compilatie van het register
RUN CGO_ENABLED=0 go build -tags devtools -o /app/bitemp-go-api .

# Zorg dat codegen- en export-tools ook gecompileerd zijn (snellere en robuustere rebuilds)
RUN CGO_ENABLED=0 go build -o /app/bin/codegen ./cmd/codegen
RUN CGO_ENABLED=0 go build -o /app/bin/export_v3 ./cmd/export_v3

# Bewaar een schone baseline van de modeldirectory, zodat een mislukte rebuild
# later niet de volgende rebuild vergiftigt met half-gegenereerde bestanden.
# De _baseline/ en _pre_rebuild/ uit de repo (COPY . .) eerst weg: anders nestte cp de kopie als
# _baseline/model/model en bleef de verouderde gecommitte baseline staan (gezien 23-10-2026:
# 8 van 12 domeinen), waarmee de crash-rollback in de entrypoint een niet-compilerende boom zou
# terugzetten. Sinds die datum staan beide mappen ook in .dockerignore.
RUN rm -rf /app/_baseline /app/_pre_rebuild && mkdir -p /app/_baseline && cp -R /app/model /app/_baseline/model

# Entrypoint script
COPY scripts/devloop-entrypoint.sh /app/scripts/devloop-entrypoint.sh
RUN chmod +x /app/scripts/devloop-entrypoint.sh

ENV DEVLOOP=true
EXPOSE 8080

ENTRYPOINT ["/app/scripts/devloop-entrypoint.sh"]
