# App mode
APP_ENV=development
GIN_MODE=debug

# Logging flags
# Bun SQL query logging (true/1 enables verbose SQL output)
BUNDEBUG=1
# Custom debug prints in handlers/model (true/1 enables extra fmt logging)
APP_DEBUG_LOGS=1

# Database connection (used by main.go)
DATABASE_URL=postgres://postgres:1234@localhost:5432/bitemp_go_db_v06?sslmode=disable

# Admin drop-table endpoint safety controls
ALLOW_DROP_TABLES=true
ADMIN_DROP_PASSWORD=1234
# Optional first-deploy DB bootstrap (enabled for local setup)
AUTO_CREATE_DATABASE="true"
DATABASE_ADMIN_URL="postgres://postgres:1234@localhost:5432/postgres?sslmode=disable"

# Sta genereren en bouwen locaal toe
DEVLOOP=true

# Legacy vars (currently not used by main.go)
DB_USER=postgres
DB_PASSWORD=1234
DB_NAME=bitemp_go_db_v06
PORT=8082

# MinIO lokaal (draait op docker)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ide-bestanden-dev
MINIO_USE_SSL=false

# Authenticatie & Autorisatie
# automatisch inloggen bij startup (voor lokale ontwikkeling)
# --> zet AUTH_ENABLED=false
# ADMIN_USERNAME en ADMIN_PASSWORD worden automatisch toegevoegd als admin user bij startup
# (als deze nog niet bestaat)
AUTH_ENABLED=true
ADMIN_USERNAME=mark
ADMIN_PASSWORD=M4rk0k12bi