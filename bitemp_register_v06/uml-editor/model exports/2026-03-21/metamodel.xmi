              <UML:ModelElement.taggedValue>
                <UML:TaggedValue tag="basistype" value="string"/>
                <UML:TaggedValue tag="format" value="nl-postcode"/>
                <UML:TaggedValue tag="documentation" value="Nederlandse postcode (4 cijfers + 2 letters)"/>
                <UML:TaggedValue tag="pattern" value="^[1-9][0-9]{3}\s?[A-Za-z]{2}$"/>
                <UML:TaggedValue tag="normalisatie" value="uppercase_letters"/>
              </UML:ModelElement.taggedValue>
            </UML:DataType>
