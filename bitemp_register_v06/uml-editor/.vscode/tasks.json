{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Vite: Start Dev Server",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "run",
        "dev",
        "--",
        "--host",
        "127.0.0.1",
        "--port",
        "5173",
        "--strictPort"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(?!x)x"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "(Local:|ready in)"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false,
        "group": "vite"
      }
    },
    {
      "label": "Vite: Stop Dev Server",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "$connections = Get-NetTCPConnection -LocalPort 5173 -State Listen -ErrorAction SilentlyContinue; if ($connections) { $processIds = $connections | Select-Object -ExpandProperty OwningProcess -Unique; foreach ($processId in $processIds) { Stop-Process -Id $processId -Force -ErrorAction SilentlyContinue; Write-Host \"Stopped process $processId on port 5173\"; } } else { Write-Host \"No process listening on port 5173\"; }"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "vite"
      }
    },
    {
      "label": "Vite: Restart Dev Server",
      "dependsOn": [
        "Vite: Stop Dev Server",
        "Vite: Start Dev Server"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Vite: Build",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "run",
        "build"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Vite: Rebuild (Clean Dist)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "if (Test-Path dist) { Remove-Item -Recurse -Force dist }; & npm.cmd run build"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Vite: Preview",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "run",
        "preview",
        "--",
        "--host",
        "127.0.0.1",
        "--port",
        "4173",
        "--strictPort"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(?!x)x"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "(Local:|ready in)"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "vite"
      }
    },
    {
      "label": "Vite: Stop Preview",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "$connections = Get-NetTCPConnection -LocalPort 4173 -State Listen -ErrorAction SilentlyContinue; if ($connections) { $processIds = $connections | Select-Object -ExpandProperty OwningProcess -Unique; foreach ($processId in $processIds) { Stop-Process -Id $processId -Force -ErrorAction SilentlyContinue; Write-Host \"Stopped process $processId on port 4173\"; } } else { Write-Host \"No process listening on port 4173\"; }"
      ],
      "problemMatcher": []
    }
  ]
}
