    {
      "naam": "NLPostcode",
      "description": "Nederlandse postcode (4 cijfers + 2 letters)",
      "basistype": "string",
      "format": "nl-postcode",
      "domein": "register",
      "positie": {
        "x": 750,
        "y": 345
      },
      "validatie": {
        "pattern": "^[1-9][0-9]{3}\\s?[A-Za-z]{2}$",
        "minLength": 6,
        "maxLength": 7,
        "voorbeelden": [
          "1234 AB",
          "9999ZZ"
        ],
        "foutmelding": "Voer een geldige postcode in (bijv. 1234 AB)"
      },
      "normalisatie": "uppercase_letters",
      "weergave": {
        "placeholder": "1234 AB",
        "inputMask": "0000 AA"
      }
    },
    {
      "naam": "BSN",
      "description": "Burgerservicenummer (9 cijfers, 11-proef)",
      "basistype": "string",
      "format": "bsn",
      "domein": "register",
      "positie": {
        "x": -480,
        "y": 165
      },
      "validatie": {
        "pattern": "^[0-9]{9}$",
        "minLength": 9,
        "maxLength": 9,
        "voorbeelden": [
          "123456782"
        ],
        "foutmelding": "Voer een geldig BSN in (9 cijfers, 11-proef)",
        "regels": [
          {
            "naam": "11-proef",
            "type": "checksum",
            "expressie": "(9*d1 + 8*d2 + 7*d3 + 6*d4 + 5*d5 + 4*d6 + 3*d7 + 2*d8 - 1*d9) % 11 == 0"
          }
        ]
      },
      "weergave": {
        "placeholder": "123456782",
        "inputMask": "000000000"
      }
    }
  ],
