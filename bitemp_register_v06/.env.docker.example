# Copy this file to .env.docker and replace values.
# Do not commit .env.docker with real secrets.

# Image tags
POSTGRES_IMAGE=postgres:16-alpine
API_IMAGE=markwestbroek/bitemp-go-api:v05.00.01

# Database container + API connection settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=bitemp_go_db_v06
DB_HOST=bitemp-postgres-v06
DB_PORT=5432
DB_SSLMODE=disable

# API runtime settings
APP_ENV=production
GIN_MODE=release
ALLOW_DROP_TABLES=false
ADMIN_DROP_PASSWORD=change-this-admin-password
# Optional first-deploy DB bootstrap (disabled by default)
# AUTO_CREATE_DATABASE="true"
# DATABASE_ADMIN_URL="postgres://postgres:<password>@<host>:5432/postgres?sslmode=disable"

# Host ports (v05 defaults, zodat v04 en v05 naast elkaar kunnen draaien)
API_PORT=8081
PG_PORT=5433
