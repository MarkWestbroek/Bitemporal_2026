# Dockerfile.api — zelfstandige backend-image voor het bitemporele register v06.
#
# Deze image bouwt alleen de Go-API binary.
# Devloop-tools en losse codegen/openapi-export binaries worden niet mee verpakt.

FROM golang:1.25-alpine AS go-builder

RUN apk add --no-cache git

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG COMMIT=dev
ARG BUILD_TIME=dev

RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo \
    -ldflags "-X 'main.commit=${COMMIT}' -X 'main.buildTime=${BUILD_TIME}'" \
    -o /out/bitemp-go-api .

FROM alpine:3.21

RUN apk --no-cache add ca-certificates

WORKDIR /root/

COPY --from=go-builder /out/bitemp-go-api ./bitemp-go-api

EXPOSE 8080

CMD ["./bitemp-go-api"]
