      "rdfs:label": {
        "@value": "het doel van de aanvraag is \"inkomensverstrekking\"",
        "@language": "nl"
      },
      "odrl:leftOperand": {
        "@id": "odrl:purpose"
      },
      "odrl:operator": {
        "@id": "odrl:eq"
      },
      "odrl:rightOperand": {
        "@id": "b:doel-inkomensverstrekking"
      }
    },
    {
      "@id": "b:doel-inkomensverstrekking",
