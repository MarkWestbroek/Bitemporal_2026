  "@graph": [
    {
      "@id": "b:beleid",
      "@type": "odrl:Set",
      "dct:title": {
        "@value": "GBO persoon",
        "@language": "nl"
      },
      "odrl:uid": {
        "@id": "b:beleid"
      },
      "odrl:profile": [
        {
          "@id": "apnl:profiel"
        },
        {
          "@id": "ts:profiel"
        }
      ],
      "dct:description": {
        "@value": "Geschreven in Toegangsspraak (klare taal) en daaruit vertaald naar ODRL. Elke regel draagt zijn oorspronkelijke zin als beschrijving. Doel: inkomensverstrekking.",
        "@language": "nl"
      },
      "dct:issued": {
        "@value": "2026-10-05",
        "@type": "xsd:date"
      },
      "odrl:conflict": {
        "@id": "odrl:prohibit"
      },
      "ts:brontekst": "Beleid \"GBO persoon\".\n  Doel: \"inkomensverstrekking\".\n\n  Begrippen.\n    Een afnemer is: iemand met rol \"afnemer\".\n    Een geautoriseerde afnemer is: iemand met autorisatie \"naam-en-adres\".\n    Inkomensgegevens zijn: alle gegevens van het inkomen van een persoon.\n\n  Regel \"persoon op bsn\".\n    Een afnemer mag alle gegevens van een persoon bekijken\n    als er een toestemming voor de betrokkene is.\n\n  Regel \"naam en adres\".\n    Een geautoriseerde afnemer mag de naam van een persoon bekijken.\n\n  Regel \"adres\".\n    Een geautoriseerde afnemer mag het adres van een persoon bekijken.\n\n  Regel \"inkomens tot en met 2024\".\n    Een afnemer mag de inkomens van een persoon bekijken\n    als het jaar van de aanvraag ten hoogste 2024 is.\n\n  Regel \"inkomen velden\".\n    Een geautoriseerde afnemer mag de inkomensgegevens bekijken.\n",
      "dpv:hasPurpose": {
        "@id": "b:doel-inkomensverstrekking"
      },
      "odrl:permission": [
        {
          "@id": "b:regel-persoon-op-bsn"
        },
        {
          "@id": "b:regel-naam-en-adres"
        },
        {
          "@id": "b:regel-adres"
        },
        {
          "@id": "b:regel-inkomens-tot-en-met-2024"
        },
        {
          "@id": "b:regel-inkomen-velden"
        }
      ]
    },
    {
      "@id": "b:vw-doel-inkomensverstrekking",
