  "@graph": [
    {
      "@id": "b:beleid",
      "@type": "odrl:Set",
      "dct:title": {
        "@value": "Inzage inkomen bij schuldhulp",
        "@language": "nl"
      },
      "odrl:uid": {
        "@id": "b:beleid"
      },
      "odrl:profile": [
        {
          "@id": "apnl:profiel"
        },
        {
          "@id": "ts:profiel"
        }
      ],
      "dct:description": {
        "@value": "Geschreven in Toegangsspraak (klare taal) en daaruit vertaald naar ODRL. Elke regel draagt zijn oorspronkelijke zin als beschrijving. Doel: schuldhulpverlening. Grondslag: de Wet gemeentelijke schuldhulpverlening.",
        "@language": "nl"
      },
      "dct:issued": {
        "@value": "2026-10-05",
        "@type": "xsd:date"
      },
      "schema:validFrom": {
        "@value": "2026-05-01",
        "@type": "xsd:date"
      },
      "odrl:conflict": {
        "@id": "odrl:prohibit"
      },
      "ts:brontekst": "Beleid \"Inzage inkomen bij schuldhulp\".\n  Geldig vanaf 1 mei 2026.\n  Grondslag: de Wet gemeentelijke schuldhulpverlening.\n  Doel: \"schuldhulpverlening\".\n\n  Begrippen.\n    Een schuldhulpverlener is: iemand met rol \"schuldhulpverlener\".\n    Inkomensgegevens zijn: alle gegevens van het inkomen van een natuurlijk persoon.\n\n  Regel \"inzage bij lopend dossier\".\n    Een schuldhulpverlener mag de inkomensgegevens bekijken\n    als aan alle volgende voorwaarden is voldaan:\n      - het doel van de aanvraag is \"schuldhulpverlening\";\n      - de achternaam van de naam van de betrokkene begint met \"A\";\n    waarbij: elke raadpleging wordt vastgelegd in het logboek.\n\n  Regel \"geen export\".\n    Een schuldhulpverlener mag de inkomensgegevens niet exporteren.\n",
      "dpv:hasLegalBasis": {
        "@id": "b:grondslag"
      },
      "dpv:hasPurpose": {
        "@id": "b:doel-schuldhulpverlening"
      },
      "odrl:permission": {
        "@id": "b:regel-inzage-bij-lopend-dossier"
      },
      "odrl:prohibition": {
        "@id": "b:regel-geen-export"
      }
    },
    {
      "@id": "b:grondslag",
      "@type": "dct:LegalResource",
      "rdfs:label": {
        "@value": "de Wet gemeentelijke schuldhulpverlening",
        "@language": "nl"
      },
      "skos:note": {
        "@value": "Grondslag zoals in de beleidstekst genoemd; nog geen verwijzing naar wetten.overheid.nl.",
        "@language": "nl"
      }
    },
