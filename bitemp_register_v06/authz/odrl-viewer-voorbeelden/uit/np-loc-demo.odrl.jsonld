  "@graph": [
    {
      "@id": "b:beleid",
      "@type": "odrl:Set",
      "dct:title": {
        "@value": "Persoonsgegevens np-loc demo",
        "@language": "nl"
      },
      "odrl:uid": {
        "@id": "b:beleid"
      },
      "odrl:profile": [
        {
          "@id": "apnl:profiel"
        },
        {
          "@id": "ts:profiel"
        }
      ],
      "dct:description": {
        "@value": "Geschreven in Toegangsspraak (klare taal) en daaruit vertaald naar ODRL. Elke regel draagt zijn oorspronkelijke zin als beschrijving. Doel: dienstverlening. Grondslag: de Gemeentewet.",
        "@language": "nl"
      },
      "dct:issued": {
        "@value": "2026-10-05",
        "@type": "xsd:date"
      },
      "schema:validFrom": {
        "@value": "2026-09-15",
        "@type": "xsd:date"
      },
      "odrl:conflict": {
        "@id": "odrl:prohibit"
      },
      "ts:brontekst": "Beleid \"Persoonsgegevens np-loc demo\".\n  Geldig vanaf 15 september 2026.\n  Grondslag: de Gemeentewet.\n  Doel: \"dienstverlening\".\n\n  Begrippen.\n    Een medewerker is: iemand met rol \"medewerker\".\n    Een medewerker West is: iemand met rol \"medewerker\" en afdeling \"West\".\n    Een telefoonmedewerker is: iemand met rol \"medewerker\" en kanaal \"telefoon\".\n    De persoonsgegevens zijn: alle gegevens van een natuurlijk persoon.\n\n  Regel \"inzage eigen stadsdeel\".\n    Een medewerker West mag de persoonsgegevens bekijken\n    als de wijk van de woonlocatie van de betrokkene \"Stadsdeel West\" is.\n\n  Regel \"avonddienst gemeentebreed\".\n    Een medewerker mag de persoonsgegevens bekijken\n    als de dienst van de aanvrager \"avond\" is.\n\n  Regel \"geen geslacht aan de telefoon\".\n    Een telefoonmedewerker mag het geslacht van een natuurlijk persoon niet bekijken.\n\n  Regel \"aanspreken zonder geslacht\".\n    Een telefoonmedewerker mag de aanspreektitel van de aanspraak van een natuurlijk persoon bekijken\n    als de aanspreektitel van de aanspraak van de betrokkene bekend is.\n",
      "dpv:hasLegalBasis": {
        "@id": "b:grondslag"
      },
      "dpv:hasPurpose": {
        "@id": "b:doel-dienstverlening"
      },
      "odrl:permission": [
        {
          "@id": "b:regel-inzage-eigen-stadsdeel"
        },
        {
          "@id": "b:regel-avonddienst-gemeentebreed"
        },
        {
          "@id": "b:regel-aanspreken-zonder-geslacht"
        }
      ],
      "odrl:prohibition": {
        "@id": "b:regel-geen-geslacht-aan-de-telefoon"
      }
    },
