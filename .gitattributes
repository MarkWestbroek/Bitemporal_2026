# Normalize all text files to LF in git history and working trees.
# Character encoding is enforced by .editorconfig (charset=utf-8).
* text=auto eol=lf

# Windows-native script formats should stay CRLF for compatibility.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# POSIX shell scripts must stay LF.
*.sh text eol=lf

# md niet scramblen
*.md text eol=lf